/*
 * helloworld.c: simple test application
 *
 * This application configures UART 16550 to baud rate 9600.
 * PS7 UART (Zynq) is not initialized by this application, since
 * bootrom/bsp configures it to baud rate 115200
 *
 * ------------------------------------------------
 * | UART TYPE   BAUD RATE                        |
 * ------------------------------------------------
 *   uartns550   9600
 *   uartlite    Configurable only in HW design
 *   ps7_uart    115200 (configured by bootrom/bsp)
 */

int main(void)
{
    uint32_t a_val;
    uint32_t b_val;
    uint32_t p_val;
    uint32_t fifo_val;
    uint32_t expected;

    int errors = 0;
    int write_index = 0;
    int read_index = 0;
    int i;

    init_platform();

    xil_printf("\r\n================================\r\n");
    xil_printf("ECE 520/L - Custom AXI IP Lab\r\n");
    xil_printf("Multiplier + FIFO Test - 100 Values\r\n");
    xil_printf("================================\r\n");

    // Reset the FIFO
    fifo_reset();

    xil_printf("\r\nInitial FIFO Status\r\n");
    fifo_status();

    // Process all 100 values in batches of up to 32
    while (read_index < NUM_WORDS)
    {
        // Fill FIFO until full or all values are written
        while (write_index < NUM_WORDS &&
               !(Xil_In32(STATUS_REG_ADDR) & STATUS_FULL))
        {
            i = write_index;

            a_val = i + 1;
            b_val = i + 1;

            p_val = multiply(a_val, b_val);
            expected = a_val * b_val;

            if (p_val != expected)
            {
                xil_printf(
                    "[FAIL] Multiplier: %d x %d = %d, expected %d\r\n",
                    (int)a_val, (int)b_val,
                    (int)p_val, (int)expected
                );
                errors++;
            }

            if (fifo_push(p_val) == 0)
            {
                xil_printf(
                    "Stored [%d]: %d x %d = %d\r\n",
                    i, (int)a_val, (int)b_val, (int)p_val
                );
                write_index++;
            }
            else
            {
                break;
            }
        }

        xil_printf("\r\nFIFO after writing:\r\n");
        fifo_status();

        // Read and verify all currently queued values
        while (read_index < write_index)
        {
            expected = (uint32_t)(read_index + 1) *
                       (read_index + 1);

            if (fifo_pop(&fifo_val) == 0)
            {
                xil_printf(
                    "Read [%d]: %d | Expected: %d",
                    read_index,
                    (int)fifo_val,
                    (int)expected
                );

                if (fifo_val == expected)
                {
                    xil_printf(" [PASS]\r\n");
                }
                else
                {
                    xil_printf(" [FAIL]\r\n");
                    errors++;
                }

                read_index++;
            }
            else
            {
                xil_printf(
                    "[FAIL] FIFO read at index %d\r\n",
                    read_index
                );
                errors++;
                goto test_complete;
            }
        }

        xil_printf("\r\nFIFO after reading:\r\n");
        fifo_status();
    }

test_complete:

    xil_printf("\r\n================================\r\n");
    xil_printf("Total Values Written: %d\r\n", write_index);
    xil_printf("Total Values Read: %d\r\n", read_index);
    xil_printf("Total Errors: %d\r\n", errors);

    if (errors == 0 &&
        write_index == NUM_WORDS &&
        read_index == NUM_WORDS)
    {
        xil_printf("ALL 100 VALUES VERIFIED SUCCESSFULLY\r\n");
    }
    else
    {
        xil_printf("MULTIPLIER + FIFO TEST FAILED\r\n");
    }

    xil_printf("================================\r\n");

    cleanup_platform();
    return 0;
}
