/*
 * helloworld.c: simple test application
 *
 * This application configures UART 16550 to baud rate 9600.
 * PS7 UART (Zynq) is not initialized by this application, since
 * bootrom/bsp configures it to baud rate 115200
 *
 * ------------------------------------------------
 * | UART TYPE   BAUD RATE                        |
 * ------------------------------------------------
 *   uartns550   9600
 *   uartlite    Configurable only in HW design
 *   ps7_uart    115200 (configured by bootrom/bsp)
 */

#include <stdio.h>
#include "platform.h"
#include "xil_printf.h"
#include "xparameters.h"
#include "xil_io.h"

#define FIFO_BASE_ADDR (0x43C10000)
#define FPGA_REV_REG_ADDR (FIFO_BASE_ADDR + 0x00)
#define FIFO_RST_REG_ADDR (FIFO_BASE_ADDR + 0x04)
#define WR_DATA_REG_ADDR (FIFO_BASE_ADDR + 0x08)
#define RD_REQ_REG_ADDR (FIFO_BASE_ADDR + 0x0C)
#define RD_DATA_REG_ADDR (FIFO_BASE_ADDR + 0x10)
#define STATUS_REG_ADDR (FIFO_BASE_ADDR + 0x14)
#define DATA_COUNT_REG_ADDR (FIFO_BASE_ADDR + 0x18)
#define CONFIG_REG_ADDR (FIFO_BASE_ADDR + 0x1C)
#define THRESHOLD_REG_ADDR (FIFO_BASE_ADDR + 0x20)

#define STATUS_EMPTY (1u << 0)
#define STATUS_FULL (1u << 1)
#define STATUS_ALMOST_EMPTY (1u << 2)
#define STATUS_ALMOST_FULL (1u << 3)
#define STATUS_RD_VALID (1u << 4)

#define FIFO_DEPTH (32)
#define NUM_WORDS (32)
#define RD_TIMEOUT (1000)

void fifo_push(uint32_t data)
{
	Xil_Out32(WR_DATA_REG_ADDR, data);
}

int fifo_pop(uint32_t *data)
{
	Xil_Out32(RD_REQ_REG_ADDR, 0x1);

	for (uint32_t t = 0; t < RD_TIMEOUT; t++)
	{
		if (Xil_In32(STATUS_REG_ADDR) & STATUS_RD_VALID)
		{
			*data = Xil_In32(RD_DATA_REG_ADDR);
			return 0;
		}
	}
	return -1;
}

// Print FIFO state
void fifo_print_status(void)
{
    uint32_t status = Xil_In32(STATUS_REG_ADDR);
    uint32_t count = Xil_In32(DATA_COUNT_REG_ADDR);

    xil_printf("Count: %d | Empty: %d | Full: %d\r\n",
               (int)count,
               (status & STATUS_EMPTY) != 0,
               (status & STATUS_FULL) != 0);

    xil_printf("Almost Empty: %d | Almost Full: %d | Valid: %d\r\n",
               (status & STATUS_ALMOST_EMPTY) != 0,
               (status & STATUS_ALMOST_FULL) != 0,
               (status & STATUS_RD_VALID) != 0);
}

int main(void)
{
    init_platform();

    uint32_t data;
    uint32_t status;
    uint32_t count;
    uint32_t expected;
    uint32_t revision;
    uint32_t config;
    uint32_t thresholds;

    xil_printf("\r\n============================\r\n");
    xil_printf("      AXI FIFO TEST\r\n");
    xil_printf("============================\r\n");

    // TEST 1: Check IP identification and configuration
    xil_printf("\r\nTEST 1: IP Configuration\r\n");

    revision = Xil_In32(FPGA_REV_REG_ADDR);
    config = Xil_In32(CONFIG_REG_ADDR);
    thresholds = Xil_In32(THRESHOLD_REG_ADDR);

    xil_printf("FPGA Revision: 0x%08x\r\n", revision);
    xil_printf("Configuration: 0x%08x\r\n", config);
    xil_printf("Thresholds: 0x%08x\r\n", thresholds);

    check(revision == 0x52000004, "FPGA revision");
    check(config == 0x01002010, "FIFO configuration");
    check(thresholds == 0x001F0001, "FIFO thresholds");

    // TEST 2: Reset FIFO
    xil_printf("\r\nTEST 2: FIFO Reset\r\n");

    fifo_reset();

    status = Xil_In32(STATUS_REG_ADDR);
    count = Xil_In32(DATA_COUNT_REG_ADDR);

    fifo_print_status();

    check(count == 0, "Count is zero after reset");
    check((status & STATUS_EMPTY) != 0, "Empty flag set");
    check((status & STATUS_FULL) == 0, "Full flag cleared");
    check((status & STATUS_RD_VALID) == 0, "Valid cleared");

    // TEST 3: Fill FIFO
    xil_printf("\r\nTEST 3: Writing 32 Values\r\n");

    for (int i = 0; i < NUM_WORDS; i++)
    {
        data = (uint32_t)(0x1000 + i);

        fifo_push(data);

        xil_printf("Write [%d]: 0x%04x\r\n", i, data);
    }

    count = Xil_In32(DATA_COUNT_REG_ADDR);
    status = Xil_In32(STATUS_REG_ADDR);

    fifo_print_status();

    check(count == FIFO_DEPTH, "Count reaches 32");
    check((status & STATUS_FULL) != 0, "Full flag set");
    check((status & STATUS_EMPTY) == 0, "Empty flag cleared");
    check((status & STATUS_ALMOST_FULL) != 0,
          "Almost full flag set");

    // TEST 4: Write while full
    xil_printf("\r\nTEST 4: Overflow Protection\r\n");

    fifo_push(0xFFFF);

    count = Xil_In32(DATA_COUNT_REG_ADDR);

    check(count == FIFO_DEPTH,
          "Extra write ignored when full");

    // TEST 5: Read and verify FIFO data
    xil_printf("\r\nTEST 5: Reading 32 Values\r\n");

    for (int i = 0; i < NUM_WORDS; i++)
    {
        expected = (uint32_t)(0x1000 + i);

        if (fifo_pop(&data) == 0)
        {
            xil_printf("Read [%d]: 0x%04x | Expected: 0x%04x",
                       i, data, expected);

            if (data == expected)
            {
                xil_printf(" [PASS]\r\n");
            }
            else
            {
                xil_printf(" [FAIL]\r\n");
                errors++;
            }
        }
        else
        {
            xil_printf("Read [%d]: TIMEOUT [FAIL]\r\n", i);
            errors++;
            break;
        }
    }

    // TEST 6: Verify empty FIFO
    xil_printf("\r\nTEST 6: Empty FIFO\r\n");

    count = Xil_In32(DATA_COUNT_REG_ADDR);
    status = Xil_In32(STATUS_REG_ADDR);

    fifo_print_status();

    check(count == 0, "Count returns to zero");
    check((status & STATUS_EMPTY) != 0, "Empty flag set");
    check((status & STATUS_FULL) == 0, "Full flag cleared");
    check((status & STATUS_ALMOST_EMPTY) != 0,
          "Almost empty flag set");

    // TEST 7: Read while empty
    xil_printf("\r\nTEST 7: Underflow Protection\r\n");

    if (fifo_pop(&data) == -1)
    {
        xil_printf("[PASS] Empty read timed out\r\n");
    }
    else
    {
        xil_printf("[FAIL] Read succeeded while empty\r\n");
        errors++;
    }

    count = Xil_In32(DATA_COUNT_REG_ADDR);
    check(count == 0, "Count unchanged after empty read");

    // TEST 8: Reset FIFO containing data
    xil_printf("\r\nTEST 8: Reset With Data\r\n");

    fifo_push(0xAAAA);
    fifo_push(0x5555);

    count = Xil_In32(DATA_COUNT_REG_ADDR);
    check(count == 2, "Two words written");

    fifo_reset();

    count = Xil_In32(DATA_COUNT_REG_ADDR);
    status = Xil_In32(STATUS_REG_ADDR);

    check(count == 0, "Reset clears stored words");
    check((status & STATUS_EMPTY) != 0,
          "Empty after reset");

    // Final results
    xil_printf("\r\n============================\r\n");

    if (errors == 0)
    {
        xil_printf(" ALL FIFO TESTS PASSED\r\n");
    }
    else
    {
        xil_printf(" FIFO TEST FAILED\r\n");
        xil_printf(" Total Errors: %d\r\n", errors);
    }

    xil_printf("============================\r\n");

    cleanup_platform();
    return 0;
}
