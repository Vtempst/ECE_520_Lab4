/*
 * helloworld.c: simple test application
 *
 * This application configures UART 16550 to baud rate 9600.
 * PS7 UART (Zynq) is not initialized by this application, since
 * bootrom/bsp configures it to baud rate 115200
 *
 * ------------------------------------------------
 * | UART TYPE   BAUD RATE                        |
 * ------------------------------------------------
 *   uartns550   9600
 *   uartlite    Configurable only in HW design
 *   ps7_uart    115200 (configured by bootrom/bsp)
 */


#include <stdio.h>
#include <stdint.h>
#include "platform.h"
#include "xil_printf.h"
#include "xparameters.h"
#include "xil_io.h"
#include "sleep.h"

// Multiplier AXI IP
#define MULT_BASE_ADDR (0x43C00000)
#define A_REG_ADDR (MULT_BASE_ADDR + 0x00)
#define B_REG_ADDR (MULT_BASE_ADDR + 0x04)
#define P_REG_ADDR (MULT_BASE_ADDR + 0x08)

// FIFO AXI IP
#define FIFO_BASE_ADDR (0x43C10000)

#define FPGA_REV_REG_ADDR   (FIFO_BASE_ADDR + 0x00)
#define FIFO_RST_REG_ADDR   (FIFO_BASE_ADDR + 0x04)
#define WR_DATA_REG_ADDR    (FIFO_BASE_ADDR + 0x08)
#define RD_REQ_REG_ADDR     (FIFO_BASE_ADDR + 0x0C)
#define RD_DATA_REG_ADDR    (FIFO_BASE_ADDR + 0x10)
#define STATUS_REG_ADDR     (FIFO_BASE_ADDR + 0x14)
#define DATA_COUNT_REG_ADDR (FIFO_BASE_ADDR + 0x18)
#define CONFIG_REG_ADDR     (FIFO_BASE_ADDR + 0x1C)
#define THRESHOLD_REG_ADDR  (FIFO_BASE_ADDR + 0x20)

// FIFO Status Flags
#define STATUS_EMPTY        (1u << 0)
#define STATUS_FULL         (1u << 1)
#define STATUS_ALMOST_EMPTY (1u << 2)
#define STATUS_ALMOST_FULL  (1u << 3)
#define STATUS_RD_VALID     (1u << 4)

#define FIFO_DEPTH 32
#define NUM_WORDS 32
#define RD_TIMEOUT 100000

// Reset FIFO
void fifo_reset(void)
{
    Xil_Out32(FIFO_RST_REG_ADDR, 0x1);
}

// Push data into FIFO
int fifo_push(uint32_t data)
{
    uint32_t status = Xil_In32(STATUS_REG_ADDR);

    if (status & STATUS_FULL)
    {
        return -1;
    }

    Xil_Out32(WR_DATA_REG_ADDR, data & 0xFFFF);

    return 0;
}

// Read data from FIFO
int fifo_pop(uint32_t *data)
{
    uint32_t status = Xil_In32(STATUS_REG_ADDR);

    if (status & STATUS_EMPTY)
    {
        return -1;
    }

    Xil_Out32(RD_REQ_REG_ADDR, 0x1);

    for (uint32_t t = 0; t < RD_TIMEOUT; t++)
    {
        status = Xil_In32(STATUS_REG_ADDR);

        if (status & STATUS_RD_VALID)
        {
            *data = Xil_In32(RD_DATA_REG_ADDR) & 0xFFFF;
            return 0;
        }
    }

    return -1;
}

// Read multiplier result
uint32_t multiply(uint32_t a, uint32_t b)
{
    Xil_Out32(A_REG_ADDR, a);
    Xil_Out32(B_REG_ADDR, b);

    // Allow registered multiplier output to update
    usleep(1);

    return Xil_In32(P_REG_ADDR);
}

// Display FIFO status
void fifo_status(void)
{
    uint32_t status = Xil_In32(STATUS_REG_ADDR);
    uint32_t count = Xil_In32(DATA_COUNT_REG_ADDR);

    xil_printf("FIFO Count: %d\r\n", (int)count);

    xil_printf("Empty: %d | Full: %d\r\n",
        (status & STATUS_EMPTY) != 0,
        (status & STATUS_FULL) != 0);

    xil_printf("Almost Empty: %d | Almost Full: %d\r\n",
        (status & STATUS_ALMOST_EMPTY) != 0,
        (status & STATUS_ALMOST_FULL) != 0);
}

int main(void)
{
    uint32_t a_val;
    uint32_t b_val;
    uint32_t p_val;
    uint32_t fifo_val;
    uint32_t expected;

    int errors = 0;
    int i;

    init_platform();

    xil_printf("\r\n================================\r\n");
    xil_printf("ECE 520/L - Custom AXI IP Lab\r\n");
    xil_printf("Multiplier + FIFO Test\r\n");
    xil_printf("================================\r\n");

    // TEST 1: Reset FIFO
    xil_printf("\r\nTEST 1: FIFO Reset\r\n");

    fifo_reset();
    fifo_status();

    if (Xil_In32(DATA_COUNT_REG_ADDR) != 0 ||
        !(Xil_In32(STATUS_REG_ADDR) & STATUS_EMPTY))
    {
        xil_printf("[FAIL] FIFO reset\r\n");
        errors++;
    }
    else
    {
        xil_printf("[PASS] FIFO reset\r\n");
    }

    // TEST 2: Multiply and store results in FIFO
    xil_printf("\r\nTEST 2: Multiplier to FIFO\r\n");

    for (i = 0; i < NUM_WORDS; i++)
    {
        a_val = i + 1;
        b_val = i + 1;

        p_val = multiply(a_val, b_val);

        // Check multiplier result
        expected = a_val * b_val;

        if (p_val != expected)
        {
            xil_printf(
                "[FAIL] Multiplier: %d x %d = %d, expected %d\r\n",
                (int)a_val, (int)b_val,
                (int)p_val, (int)expected
            );
            errors++;
        }

        // Store multiplication result in FIFO
        if (fifo_push(p_val) == 0)
        {
            xil_printf(
                "Stored FIFO[%d]: %d x %d = %d\r\n",
                i, (int)a_val, (int)b_val, (int)p_val
            );
        }
        else
        {
            xil_printf("[FAIL] FIFO full at index %d\r\n", i);
            errors++;
            break;
        }
    }

    // TEST 3: Check FIFO Full
    xil_printf("\r\nTEST 3: FIFO Full Status\r\n");

    fifo_status();

    if ((Xil_In32(STATUS_REG_ADDR) & STATUS_FULL) &&
        Xil_In32(DATA_COUNT_REG_ADDR) == FIFO_DEPTH)
    {
        xil_printf("[PASS] FIFO Full\r\n");
    }
    else
    {
        xil_printf("[FAIL] FIFO Full\r\n");
        errors++;
    }

    // TEST 4: Read FIFO contents
    xil_printf("\r\nTEST 4: Read FIFO Contents\r\n");

    for (i = 0; i < NUM_WORDS; i++)
    {
        expected = (uint32_t)(i + 1) * (i + 1);

        if (fifo_pop(&fifo_val) == 0)
        {
            xil_printf(
                "FIFO[%d] = %d | Expected = %d",
                i, (int)fifo_val, (int)expected
            );

            if (fifo_val == expected)
            {
                xil_printf(" [PASS]\r\n");
            }
            else
            {
                xil_printf(" [FAIL]\r\n");
                errors++;
            }
        }
        else
        {
            xil_printf("[FAIL] FIFO read at index %d\r\n", i);
            errors++;
            break;
        }
    }

    // TEST 5: Check FIFO Empty
    xil_printf("\r\nTEST 5: FIFO Empty Status\r\n");

    fifo_status();

    if ((Xil_In32(STATUS_REG_ADDR) & STATUS_EMPTY) &&
        Xil_In32(DATA_COUNT_REG_ADDR) == 0)
    {
        xil_printf("[PASS] FIFO Empty\r\n");
    }
    else
    {
        xil_printf("[FAIL] FIFO Empty\r\n");
        errors++;
    }

    // Final Result
    xil_printf("\r\n================================\r\n");

    if (errors == 0)
    {
        xil_printf("ALL TESTS PASSED\r\n");
    }
    else
    {
        xil_printf("TEST FAILED: %d errors\r\n", errors);
    }

    xil_printf("End of Multiplier + FIFO Test\r\n");
    xil_printf("================================\r\n");

    cleanup_platform();
    return 0;
}
